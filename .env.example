# Database
DATABASE_URL="postgresql://user:password@localhost:5432/foodhub?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRE="7d"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# Cloudinary (optional for uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Super Admin Default (created on first run)
SUPERADMIN_EMAIL="admin@foodhub.com"
SUPERADMIN_PASSWORD="Admin@123456"
SUPERADMIN_FIRSTNAME="Super"
SUPERADMIN_LASTNAME="Admin"
